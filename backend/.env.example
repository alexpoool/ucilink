# Servidor
NODE_ENV=development
PORT=4000

# Base de datos (PostgreSQL — el esquema base vive en esquema.sql)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ucilink

# Auth
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Logs
LOG_LEVEL=info
